# 실행 환경: development | production
APP_ENV=development

# 세션 쿠키 서명 키. 운영 환경에서는 반드시 무작위 긴 문자열로 바꾸세요.
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL (docker compose 기본값). 빠른 로컬 실행은 sqlite:///./dev.db 도 가능합니다.
DATABASE_URL=postgresql+psycopg://glowup:glowup@localhost:5433/glowup

# 공개 폼·배포 링크가 노출되는 기준 URL (끝에 / 없이)
PUBLIC_BASE_URL=http://localhost:8000

# 초기 운영자 계정 (uv run python -m app.seed 로 생성)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# 세션 유효시간(초), 업로드 HTML 최대 크기(바이트)
SESSION_MAX_AGE_SECONDS=28800
MAX_HTML_BYTES=524288
